	},
	"dependencies": {
		"@astral-sh/ruff-wasm-web": "^0.17.6",
		"prettier": "^3.10.1",
		"prettier-plugin-java": "^2.12.0"
	},
	"description": "",
	"devDependencies": {
		"@lusc/eslint-config": "^21.1.0",
		"@lusc/tsconfig": "^8.0.0",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"typescript": "^7.0.2"
	},
	"type": "module",
	"license": "GPL-3.0-or-later",
	"name": "eth-userscripts",
	"private": true,
	"scripts": {
		"build": "pnpm typecheck && pnpm esbuild",
		"esbuild": "node scripts/build.ts",
		"esbuild:w": "node scripts/build.ts --watch",
		"fmt": "prettier -w . && eslint --fix",
		"start": "pnpm run '/:w$|serve$/'",
		"typecheck": "tsc --noEmit && tsc -p scripts",
		"typecheck:w": "tsc --noEmit --watch --preserveWatchOutput",
		"serve": "python -m http.server -d dist -b 127.0.0.1 3000"
	},
	"engines": {
		"node": "^26.13.1"
	},
	"sideEffects": false,
	"version": "1.0.0",
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
