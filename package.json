	"dependencies": {
		"prettier": "^3.9.6",
		"prettier-plugin-java": "^2.10.3"
	},
	"description": "",
	"devDependencies": {
		"@lusc/eslint-config": "^18.0.0",
		"@lusc/tsconfig": "^7.2.1",
		"@types/node": "^24.13.3",
		"concurrently": "^10.0.4",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"serve": "^14.2.6",
		"typescript": "^6.0.3"
	},
	"type": "module",
	"license": "GPL-3.0-or-later",
	"name": "eth-userscripts",
	"private": true,
	"scripts": {
		"build": "pnpm typecheck && pnpm esbuild",
		"esbuild": "node scripts/build.ts",
		"esbuild:w": "node scripts/build.ts --watch",
		"fmt": "prettier -w . && eslint --fix",
		"start": "concurrently pnpm:esbuild:w pnpm:typecheck:w pnpm:serve -r -k",
		"typecheck": "tsc --noEmit && tsc -p scripts",
		"typecheck:w": "tsc --noEmit --watch --preserveWatchOutput",
		"serve": "serve dist -L"
	},
	"engines": {
		"node": "^24.18.1"
	},
	"sideEffects": false,
	"version": "1.0.0",
	"packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
