	"dependencies": {
		"prettier": "^3.9.6",
		"prettier-plugin-java": "^2.10.3"
	},
	"description": "",
	"devDependencies": {
		"@lusc/eslint-config": "^18.0.0",
		"@lusc/tsconfig": "^7.2.1",
		"@types/node": "^24.13.3",
		"concurrently": "^10.0.4",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"serve": "^14.2.6",
		"typescript": "^7.0.2"
	},
	"type": "module",
	"license": "GPL-3.0-or-later",
	"name": "eth-userscripts",
	"private": true,
	"scripts": {
		"build": "pnpm typecheck && pnpm esbuild",
		"esbuild": "node scripts/build.ts",
		"esbuild:w": "node scripts/build.ts --watch",
		"fmt": "prettier -w . && eslint --fix",
		"start": "concurrently pnpm:esbuild:w pnpm:typecheck:w pnpm:serve -r -k",
		"typecheck": "tsc --noEmit && tsc -p scripts",
		"typecheck:w": "tsc --noEmit --watch --preserveWatchOutput",
		"serve": "serve dist -L"
	},
	"engines": {
		"node": "^24.18.1"
	},
	"sideEffects": false,
	"version": "1.0.0",
	"packageManager": "pnpm@12.3.1+sha512.3c14c15408d1489d350f8ed7f93361d26cc707054f6849a4eea3bb7407ff4fe4564b413a1c421a773a176ab1168a8df1c7d548f2cd0dc7d344f58c4e680a5b18"
}
